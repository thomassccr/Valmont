# ─────────────────────────────────────────────────────────────
# Valmont — configuration locale
# Copier en `.env` à la racine. Rien de tout cela ne quitte la machine
# en dehors des appels explicites aux fournisseurs choisis.
# ─────────────────────────────────────────────────────────────

# ── Emplacement des données (mémoire, index, journaux) ──
# Par défaut : ~/.valmont
VALMONT_HOME=

# ── Modèle de langage ──
# Fournisseur : anthropic | mock
VALMONT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Modèle de conversation (qualité maximale, c'est la voix de Valmont)
VALMONT_LLM_MODEL=claude-opus-5
# Modèle des tâches de fond (extraction, résumés, classification)
VALMONT_LLM_FAST_MODEL=claude-sonnet-5

# ── Embeddings (mémoire vectorielle) ──
# Fournisseur : openai | ollama | local
#   openai → text-embedding-3-small (qualité/prix imbattables)
#   ollama → 100% local, aucune donnée ne sort (nomic-embed-text)
#   local  → repli déterministe sans réseau (dégradé, dev uniquement)
VALMONT_EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
VALMONT_EMBEDDING_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Serveur du noyau ──
VALMONT_CORE_HOST=127.0.0.1
VALMONT_CORE_PORT=4319
# Jeton partagé entre le noyau et les clients (généré au premier lancement si vide)
VALMONT_TOKEN=

# ── Indexation des projets ──
# Dossiers scannés par le module `projects`, séparés par `:`
VALMONT_PROJECT_ROOTS=

# ── Voix ──
# TTS : web | elevenlabs
VALMONT_TTS_PROVIDER=web
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Journalisation ──
VALMONT_LOG_LEVEL=info

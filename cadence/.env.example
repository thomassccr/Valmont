# ─── Serveur ───────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Origine du front en dev (CORS). En prod le front est servi par l'API.
WEB_ORIGIN=http://localhost:5173
# Secret utilisé pour signer les cookies de session (obligatoire en prod)
SESSION_SECRET=change-moi-en-production

# ─── Base de données ───────────────────────────────────────
# Fichier SQLite. Mettre un chemin persistant en production.
DATABASE_PATH=./data/cadence.db

# ─── Compte administrateur créé au premier démarrage ───────
ADMIN_EMAIL=admin@cadence.local
ADMIN_PASSWORD=cadence
ADMIN_NAME=Admin

# ─── Fournisseur de génération ─────────────────────────────
# anthropic | local   (local = moteur de composition hors ligne, sans clé API)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=8000

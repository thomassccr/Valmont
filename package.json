{
  "name": "valmont",
  "private": true,
  "version": "0.1.0",
  "description": "Valmont — intelligence personnelle persistante",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "pnpm -r run typecheck",
    "dev": "pnpm --parallel --filter \"./apps/*\" run dev",
    "dev:core": "pnpm --filter @valmont/core run dev",
    "dev:ui": "pnpm --filter @valmont/ui run dev",
    "clean": "pnpm -r exec rm -rf dist .next node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
